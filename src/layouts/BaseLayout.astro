---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Digitales Bildungswerk Hildesheim – Ihr Partner für digitale Weiterbildung, Kurse und Workshops.' } = Astro.props;
const fullTitle = `${title} | Digitales Bildungswerk Hildesheim`;
const canonicalUrl = Astro.url.href;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F97316" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="/images/hero-collaboration.jpg" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="Digitales Bildungswerk Hildesheim" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/images/hero-collaboration.jpg" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <title>{fullTitle}</title>
  </head>
  <body class="flex flex-col min-h-screen">
    <!-- Skip to content (Accessibility) -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-primary-500 focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:text-sm focus:font-semibold">
      Zum Inhalt springen
    </a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Mobile Sticky CTA Bar -->
    <div class="lg:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur-md border-t border-slate-200 mobile-cta-bar" id="mobile-cta">
      <div class="flex gap-3 px-4 py-3">
        <a href="/kurse" class="flex-1 inline-flex items-center justify-center gap-2 bg-primary-500 text-white py-3 rounded-xl text-sm font-semibold hover:bg-primary-600 active:bg-primary-700 transition-colors shadow-sm">
          Kurse entdecken
        </a>
        <a href="tel:+4951211234567" class="inline-flex items-center justify-center bg-slate-100 text-slate-700 px-4 py-3 rounded-xl hover:bg-slate-200 active:bg-slate-300 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
          </svg>
        </a>
      </div>
    </div>

    <CookieBanner />

    <script>
      // Hide mobile CTA bar when cookie banner is visible
      const cookieBanner = document.getElementById('cookie-banner');
      const mobileCta = document.getElementById('mobile-cta');
      if (cookieBanner && mobileCta && !cookieBanner.classList.contains('hidden')) {
        mobileCta.style.display = 'none';
      }
      // Show CTA bar when cookie banner is dismissed
      document.getElementById('cookie-accept')?.addEventListener('click', () => {
        if (mobileCta) mobileCta.style.display = '';
      });
      document.getElementById('cookie-reject')?.addEventListener('click', () => {
        if (mobileCta) mobileCta.style.display = '';
      });
    </script>
  </body>
</html>
