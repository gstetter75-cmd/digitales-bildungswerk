<div id="cookie-banner" class="fixed bottom-0 inset-x-0 z-50 hidden safe-bottom">
  <div class="bg-white border-t border-slate-200 shadow-2xl">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 sm:gap-4">
        <div class="flex-1">
          <p class="text-xs sm:text-sm text-slate-700">
            Wir verwenden Cookies, um Ihnen die bestmögliche Erfahrung auf unserer Website zu bieten.
            <a href="/datenschutz" class="text-primary-600 hover:text-primary-700 underline">Mehr erfahren</a>
          </p>
        </div>
        <div class="flex gap-3 shrink-0 w-full sm:w-auto">
          <button id="cookie-reject" class="flex-1 sm:flex-none px-4 py-2.5 text-sm font-medium text-slate-600 bg-slate-100 rounded-lg hover:bg-slate-200 active:bg-slate-300 transition-colors">
            Nur notwendige
          </button>
          <button id="cookie-accept" class="flex-1 sm:flex-none px-4 py-2.5 text-sm font-medium text-white bg-primary-500 rounded-lg hover:bg-primary-600 active:bg-primary-700 transition-colors">
            Alle akzeptieren
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const banner = document.getElementById('cookie-banner');
  const acceptBtn = document.getElementById('cookie-accept');
  const rejectBtn = document.getElementById('cookie-reject');

  if (!localStorage.getItem('cookie-consent')) {
    banner?.classList.remove('hidden');
  }

  acceptBtn?.addEventListener('click', () => {
    localStorage.setItem('cookie-consent', 'all');
    banner?.classList.add('hidden');
  });

  rejectBtn?.addEventListener('click', () => {
    localStorage.setItem('cookie-consent', 'essential');
    banner?.classList.add('hidden');
  });
</script>
