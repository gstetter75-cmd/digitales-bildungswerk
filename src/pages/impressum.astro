---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Impressum" description="Impressum des Digitalen Bildungswerks Hildesheim.">

  <section class="bg-gradient-to-br from-slate-900 to-slate-800 py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white">Impressum</h1>
    </div>
  </section>

  <section class="bg-white py-12 lg:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 prose prose-slate">

      <h2>Angaben gemäß § 5 TMG</h2>
      <p>
        Digitales Bildungswerk Hildesheim<br />
        Wetzellplatz 2<br />
        31137 Hildesheim
      </p>

      <h2>Vertreten durch</h2>
      <p>Dr. Maria Schmidt (Geschäftsführung)</p>

      <h2>Kontakt</h2>
      <p>
        Telefon: 05121 / 123 456 7<br />
        E-Mail: info@digitales-bildungswerk.de
      </p>

      <h2>Registereintrag</h2>
      <p>
        Eintragung im Handelsregister<br />
        Registergericht: Amtsgericht Hildesheim<br />
        Registernummer: HRB XXXXX
      </p>

