---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Kontakt" description="Nehmen Sie Kontakt mit dem Digitalen Bildungswerk Hildesheim auf. Wir beraten Sie gerne.">

  <!-- Header -->
  <section class="bg-gradient-to-br from-slate-900 to-slate-800 py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white mb-4">Kontakt</h1>
      <p class="text-lg text-slate-300 max-w-2xl">Wir freuen uns auf Ihre Nachricht. Egal ob Frage, Beratungswunsch oder Feedback – wir sind für Sie da.</p>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- Kontaktinformationen -->
        <div class="space-y-8">
          <div>
            <h2 class="text-2xl font-bold text-slate-900 mb-6">So erreichen Sie uns</h2>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-primary-50 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-primary-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-slate-900 mb-1">Adresse</h3>
              <p class="text-slate-500">Digitales Bildungswerk Hildesheim<br />Wetzellplatz 2<br />31137 Hildesheim</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-primary-50 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-primary-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-slate-900 mb-1">E-Mail</h3>
              <a href="mailto:info@digitales-bildungswerk.de" class="text-primary-600 hover:text-primary-700 transition-colors">info@digitales-bildungswerk.de</a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-primary-50 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-primary-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-slate-900 mb-1">Telefon</h3>
              <a href="tel:+4951211234567" class="text-primary-600 hover:text-primary-700 transition-colors">05121 / 123 456 7</a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-primary-50 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-primary-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-slate-900 mb-1">Öffnungszeiten</h3>
              <p class="text-slate-500">Mo – Fr: 09:00 – 17:00 Uhr<br />Sa: nach Vereinbarung</p>
            </div>
          </div>
        </div>

        <!-- Kontaktformular -->
        <div class="lg:col-span-2">
          <div class="bg-slate-50 rounded-2xl p-8 border border-slate-100">
            <h2 class="text-2xl font-bold text-slate-900 mb-6">Nachricht senden</h2>
            <form class="space-y-5" netlify name="kontakt">
              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-1.5">Vorname *</label>
                  <input type="text" name="vorname" required class="w-full px-4 py-3 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent bg-white" />
                </div>
                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-1.5">Nachname *</label>
                  <input type="text" name="nachname" required class="w-full px-4 py-3 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent bg-white" />
                </div>
              </div>
              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-1.5">E-Mail *</label>
                  <input type="email" name="email" required class="w-full px-4 py-3 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent bg-white" />
                </div>
                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-1.5">Telefon</label>
                  <input type="tel" name="telefon" class="w-full px-4 py-3 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent bg-white" />
                </div>
              </div>
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1.5">Betreff</label>
                <select name="betreff" class="w-full px-4 py-3 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent bg-white">
                  <option value="">Bitte wählen</option>
                  <option>Allgemeine Anfrage</option>
                  <option>Kursberatung</option>
                  <option>Fördermöglichkeiten</option>
                  <option>Firmenschulung</option>
                  <option>Feedback</option>
                </select>
              </div>
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1.5">Nachricht *</label>
                <textarea name="nachricht" rows="5" required class="w-full px-4 py-3 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent bg-white"></textarea>
              </div>
              <div class="flex items-start gap-2">
                <input type="checkbox" name="datenschutz" required class="mt-1 rounded border-slate-300 text-primary-500 focus:ring-primary-500" />
                <label class="text-sm text-slate-500">Ich habe die <a href="/datenschutz" class="text-primary-600 underline">Datenschutzerklärung</a> gelesen und stimme der Verarbeitung meiner Daten zu. *</label>
              </div>
              <button type="submit" class="bg-primary-500 text-white px-8 py-3.5 rounded-xl font-semibold hover:bg-primary-600 transition-colors shadow-lg shadow-primary-500/25">
                Nachricht senden
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="bg-slate-50 py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-bold text-slate-900 mb-3">Newsletter abonnieren</h2>
      <p class="text-slate-500 mb-6">Erhalten Sie Updates zu neuen Kursen und Angeboten</p>
      <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto" netlify name="newsletter-kontakt">
        <input type="email" name="email" required placeholder="Ihre E-Mail-Adresse" class="flex-1 px-4 py-3 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent" />
        <button type="submit" class="bg-primary-500 text-white px-6 py-3 rounded-lg text-sm font-semibold hover:bg-primary-600 transition-colors">
          Anmelden
        </button>
      </form>
    </div>
  </section>

</BaseLayout>
