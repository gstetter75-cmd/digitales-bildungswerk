---
import BaseLayout from '../layouts/BaseLayout.astro';

const angebote = [
  {
    title: 'Inhouse-Schulungen',
    desc: 'Maßgeschneiderte Schulungen direkt in Ihrem Unternehmen. Wir passen Inhalte, Dauer und Niveau an Ihre Bedürfnisse an.',
    icon: 'M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21',
  },
  {
    title: 'Team-Workshops',
    desc: 'Interaktive Workshops für Ihr gesamtes Team. Von Design Thinking bis agile Methoden – wir bringen Ihr Team auf das nächste Level.',
    icon: 'M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z',
  },
  {
    title: 'Digitale Transformation',
    desc: 'Wir begleiten Ihr Unternehmen auf dem Weg zur Digitalisierung. Strategie, Implementierung und Mitarbeiterschulung aus einer Hand.',
    icon: 'M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z',
  },
  {
    title: 'KI-Beratung',
    desc: 'Identifizieren Sie KI-Potenziale in Ihrem Unternehmen. Wir helfen bei der Strategie und schulen Ihre Mitarbeiter im Umgang mit KI-Tools.',
    icon: 'M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18',
  },
];

const vorteile = [
  'Individuelle Kursinhalte nach Ihrem Bedarf',
  'Flexible Termine – auch am Wochenende',
  'Erfahrene Dozenten aus der Praxis',
  'Vor Ort oder Online möglich',
  'Teilnahmezertifikate für alle Mitarbeiter',
  'Rabatte ab 5 Teilnehmern',
];
---

<BaseLayout title="Für Unternehmen" description="Maßgeschneiderte Firmenschulungen und Workshops für die digitale Transformation. Inhouse oder online.">

  <!-- Header -->
  <section class="relative bg-gradient-to-br from-slate-900 to-slate-800 py-16 lg:py-20 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/business-team.jpg" alt="" class="w-full h-full object-cover opacity-20" />
      <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/90 to-slate-800/80"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="inline-flex items-center gap-2 bg-primary-500/10 border border-primary-500/20 text-primary-300 px-4 py-1.5 rounded-full text-sm font-medium mb-6">
        Für Unternehmen
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white mb-4">Digitale Kompetenz<br />für Ihr Team</h1>
      <p class="text-lg text-slate-300 max-w-2xl">Maßgeschneiderte Schulungen und Workshops, die Ihr Unternehmen fit für die digitale Zukunft machen.</p>
    </div>
  </section>

  <!-- Angebote -->
  <section class="bg-white py-20 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-extrabold text-slate-900 mb-12 text-center">Unsere Leistungen für Unternehmen</h2>
      <div class="grid md:grid-cols-2 gap-8">
        {angebote.map((a) => (
          <div class="bg-slate-50 rounded-2xl p-8 border border-slate-100 hover:border-primary-200 hover:shadow-lg transition-all">
            <div class="w-14 h-14 bg-primary-50 rounded-xl flex items-center justify-center mb-6">
              <svg class="w-7 h-7 text-primary-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={a.icon} />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">{a.title}</h3>
            <p class="text-slate-500 leading-relaxed">{a.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Vorteile -->
  <section class="bg-slate-50 py-20 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-3xl font-extrabold text-slate-900 mb-6">Warum Digitales Bildungswerk?</h2>
          <p class="text-lg text-slate-500 mb-8">Wir verstehen die Herausforderungen der digitalen Transformation und bieten praxisnahe Lösungen für Ihr Unternehmen.</p>
          <div class="space-y-4">
            {vorteile.map((v) => (
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                </svg>
                <span class="text-slate-700">{v}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-lg">
          <h3 class="text-xl font-bold text-slate-900 mb-6">Unverbindliches Angebot anfordern</h3>
          <form class="space-y-4" netlify name="unternehmen-anfrage">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Firma</label>
              <input type="text" name="firma" required class="w-full px-3 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Ansprechpartner</label>
              <input type="text" name="name" required class="w-full px-3 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">E-Mail</label>
              <input type="email" name="email" required class="w-full px-3 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Gewünschtes Thema</label>
              <select name="thema" class="w-full px-3 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 bg-white">
                <option value="">Bitte wählen</option>
                <option>Inhouse-Schulung</option>
                <option>Team-Workshop</option>
                <option>Digitale Transformation</option>
                <option>KI-Beratung</option>
                <option>Sonstiges</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Nachricht</label>
              <textarea name="nachricht" rows="4" class="w-full px-3 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500"></textarea>
            </div>
            <button type="submit" class="w-full bg-primary-500 text-white py-3 rounded-xl font-semibold hover:bg-primary-600 transition-colors">
              Angebot anfordern
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
