---

<BaseLayout title="Kursangebot" description="Alle Kurse und Weiterbildungen des Digitalen Bildungswerks Hildesheim. Filtern Sie nach Kategorie, Format und Zielgruppe.">

  <!-- Page Header -->
  <section class="relative bg-gradient-to-br from-slate-900 to-slate-800 py-16 lg:py-20 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/classroom.jpg" alt="" class="w-full h-full object-cover opacity-20" />
      <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/90 to-slate-800/80"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white mb-4">Kursangebot</h1>
      <p class="text-lg text-slate-300 max-w-2xl">Finden Sie den passenden Kurs für Ihre Ziele. Alle Kurse mit Praxisbezug und erfahrenen Dozenten.</p>
    </div>
  </section>

  <!-- Filter & Kurse -->
  <section class="bg-slate-50 py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Filter Bar -->
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 mb-10">
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1.5">Suche</label>
            <input id="search-input" type="text" placeholder="Kurs suchen..." class="w-full px-3 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1.5">Kategorie</label>
            <select id="filter-kategorie" class="w-full px-3 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent bg-white">
              <option value="">Alle Kategorien</option>
              {Object.entries(kategorien).map(([key, label]) => (
                <option value={key}>{label}</option>
              ))}
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1.5">Format</label>
            <select id="filter-format" class="w-full px-3 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent bg-white">
              <option value="">Alle Formate</option>
              {Object.entries(formate).map(([key, label]) => (
                <option value={key}>{label}</option>
              ))}
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1.5">Zielgruppe</label>
            <select id="filter-zielgruppe" class="w-full px-3 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent bg-white">
              <option value="">Alle Zielgruppen</option>
              {Object.entries(zielgruppen).map(([key, label]) => (
                <option value={key}>{label}</option>
              ))}
            </select>
          </div>
        </div>
      </div>

      <!-- Kurs-Grid -->
      <div id="kurs-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {kurse.map((kurs) => (
          <a
            href={`/kurse/${kurs.slug}`}
            class="kurs-card group bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-xl hover:border-primary-200 transition-all"
            data-kategorie={kurs.kategorie}
            data-format={kurs.format}
            data-zielgruppe={kurs.zielgruppe}
            data-title={kurs.title.toLowerCase()}
            data-desc={kurs.description.toLowerCase()}
          >
            <div class="bg-gradient-to-br from-slate-800 to-slate-900 p-6">
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-medium text-primary-300 bg-primary-500/10 px-3 py-1 rounded-full">{kategorien[kurs.kategorie]}</span>
                {kurs.bildungsgutschein && (
                  <span class="text-xs font-medium text-emerald-300 bg-emerald-500/10 px-3 py-1 rounded-full">Förderbar</span>
                )}
              </div>
              <div class="w-12 h-12 bg-white/10 rounded-xl flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-primary-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d={iconMap[kurs.icon]} />
                </svg>
              </div>
              <h3 class="text-xl font-bold text-white">{kurs.title}</h3>
            </div>
            <div class="p-6">
              <p class="text-slate-500 text-sm leading-relaxed mb-4">{kurs.description}</p>
              <div class="flex items-center justify-between text-sm">
                <div class="flex items-center gap-4 text-slate-400">
                  <span class="flex items-center gap-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                    {kurs.dauer}
                  </span>
                  <span class="capitalize">{kurs.format}</span>
                </div>
                <span class="font-bold text-slate-900">{kurs.preis.toLocaleString('de-DE')} €</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <p id="no-results" class="hidden text-center text-slate-500 py-16 text-lg">Keine Kurse gefunden. Bitte ändern Sie Ihre Filterkriterien.</p>
    </div>
  </section>

</BaseLayout>

<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const filterKategorie = document.getElementById('filter-kategorie') as HTMLSelectElement;
  const filterFormat = document.getElementById('filter-format') as HTMLSelectElement;
  const filterZielgruppe = document.getElementById('filter-zielgruppe') as HTMLSelectElement;
  const cards = document.querySelectorAll('.kurs-card') as NodeListOf<HTMLElement>;
  const noResults = document.getElementById('no-results');

  function filterKurse() {
    const search = searchInput.value.toLowerCase();
    const kategorie = filterKategorie.value;
    const format = filterFormat.value;
    const zielgruppe = filterZielgruppe.value;
    let visibleCount = 0;

    cards.forEach((card) => {
      const matchSearch = !search || card.dataset.title?.includes(search) || card.dataset.desc?.includes(search);
      const matchKategorie = !kategorie || card.dataset.kategorie === kategorie;
      const matchFormat = !format || card.dataset.format === format;
      const matchZielgruppe = !zielgruppe || card.dataset.zielgruppe === zielgruppe || card.dataset.zielgruppe === 'alle';

      const visible = matchSearch && matchKategorie && matchFormat && matchZielgruppe;
      card.style.display = visible ? '' : 'none';
      if (visible) visibleCount++;
    });

    if (noResults) {
      noResults.classList.toggle('hidden', visibleCount > 0);
    }
  }

  searchInput?.addEventListener('input', filterKurse);
  filterKategorie?.addEventListener('change', filterKurse);
  filterFormat?.addEventListener('change', filterKurse);
  filterZielgruppe?.addEventListener('change', filterKurse);
</script>
